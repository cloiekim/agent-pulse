{
  "manifest_version": 3,
  "name": "Agent Pulse",
  "version": "0.1.0",
  "description": "Watches your ChatGPT and Claude tabs and reports their state to the Agent Pulse menu bar app. Runs entirely on your machine.",

  "permissions": ["storage"],

  "host_permissions": ["http://127.0.0.1/*"],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["src/inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["src/bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Agent Pulse"
  }
}
